#ifndef SNIPERFX_RETCODE_POLICY_MQH
#define SNIPERFX_RETCODE_POLICY_MQH

string TradeRetcodeClass(const uint retcode)
  {
   switch(retcode)
     {
      case TRADE_RETCODE_PLACED: case TRADE_RETCODE_DONE: case TRADE_RETCODE_DONE_PARTIAL: return("PROGRESS");
      case TRADE_RETCODE_REQUOTE: case TRADE_RETCODE_PRICE_CHANGED: case TRADE_RETCODE_PRICE_OFF: return("TRANSIENT_PRICE");
      case TRADE_RETCODE_TIMEOUT: case TRADE_RETCODE_CONNECTION: case TRADE_RETCODE_LOCKED: case TRADE_RETCODE_TOO_MANY_REQUESTS: return("TRANSIENT_INFRASTRUCTURE");
      case TRADE_RETCODE_INVALID: case TRADE_RETCODE_INVALID_VOLUME: case TRADE_RETCODE_INVALID_PRICE: case TRADE_RETCODE_INVALID_STOPS: case TRADE_RETCODE_INVALID_FILL: return("PERMANENT_REQUEST");
      case TRADE_RETCODE_TRADE_DISABLED: case TRADE_RETCODE_MARKET_CLOSED: return("PERMISSION_OR_SESSION");
      case TRADE_RETCODE_NO_MONEY: case TRADE_RETCODE_LIMIT_ORDERS: case TRADE_RETCODE_LIMIT_VOLUME: return("CAPITAL_OR_LIMIT");
     }
   return("UNCLASSIFIED");
  }

#endif
